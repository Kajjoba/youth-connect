# =====================================================================
# YouthConnect Platform: server configuration
#
# Copy this file to server/.env and fill in the values. .env is ignored
# by git and must never be committed: it carries the database
# credentials and both token signing secrets.
#
# ADR-003: the process REFUSES TO START if a required value is missing,
# rather than substituting a development default. A silent fallback is
# how a deployed system ends up signing tokens with a string that is
# published in a repository.
# =====================================================================

# ---------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------

# Postgres connection string.
#
#   local:  postgres://ycp:ycp@127.0.0.1:5432/ycp_dev
#   Neon:   postgres://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/DBNAME?sslmode=require
#
# TLS is verified automatically for any non-loopback host and skipped for
# 127.0.0.1 and localhost, so there is nothing else to configure.
DATABASE_URL=replace_me

# Token signing secrets. Two DIFFERENT values, because a refresh token
# that validates as an access token defeats the point of having short
# access tokens at all.
#
# Generate each one with:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Run that on the machine that will use it. A secret that has been pasted
# into a chat, an issue or a commit message is no longer a secret.
JWT_ACCESS_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me

# ---------------------------------------------------------------------
# OPTIONAL: shown with their defaults
# ---------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Comma separated. The Vite dev server runs on 5173.
CORS_ORIGINS=http://localhost:5173

# Access tokens are deliberately short lived (ADR-006). The refresh
# token rotates on every use and a reused one revokes the whole family.
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=30

# Level Two (teams, projects, showcase) is written but shipped disabled
# so the CAT 1 surface stays focused. ADR-001.
FEATURE_LEVEL_TWO=false

# ADR-029: "Continue with Google". Leave blank and the server starts
# fine; the endpoint just refuses every request, and the client hides
# the button when it has nothing to point at (see client/.env.example).
#
# To get one: console.cloud.google.com -> create or pick a project ->
# APIs & Services -> Credentials -> Create Credentials -> OAuth client
# ID -> Application type "Web application" -> add
# http://localhost:5173 under "Authorized JavaScript origins" (and your
# real domain, once there is one) -> no redirect URI is needed for this
# flow. Copy the Client ID it gives you; there is no secret to copy,
# because the server only ever VERIFIES a token Google already signed,
# it never exchanges anything with Google directly.
#
# This same value also goes into client/.env as VITE_GOOGLE_CLIENT_ID -
# it is a public identifier, safe to ship in the browser bundle, not a
# credential.
GOOGLE_CLIENT_ID=

# Connection pool. The defaults are 10 connections locally, 3 under
# NODE_ENV=test, and a 30 second connect timeout against a remote host
# so a suspended serverless compute has time to wake. ADR-004.
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_MS=30000

# debug | info | warn | error
LOG_LEVEL=info
